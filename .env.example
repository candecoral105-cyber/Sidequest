# Copy this file to .env.local and paste your keys after the = sign.
# .env.local is never uploaded to GitHub. Restart the app after changing it.

# --- Gemini (free) ---------------------------------------------------------
# Get a key: https://aistudio.google.com/apikey  (or mlh.link/aistudio)
# Powers: mood search, personal reasons, timetable screenshots, poster reading.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: models to try when the main one is busy or out of free quota (comma-separated).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Google Maps (needs a billing card; free monthly allowance covers a hackathon)
# console.cloud.google.com -> new project -> enable "Maps JavaScript API", "Places API (New)" and "Routes API"
# -> Credentials -> Create API key. Paste the SAME key in both lines below.
# If left empty, the app uses the free OpenStreetMap map instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud -> Map Management (DEMO_MAP_ID works for testing)
NEXT_PUBLIC_GOOGLE_MAP_ID=

# --- ElevenLabs (voice: mic search + reading picks aloud) --------------------
# elevenlabs.io -> Developers -> API Keys. If left empty, the browser's built-in voice is used instead.
ELEVENLABS_API_KEY=
# Optional: a different voice (default "Sarah", EXAVITQu4vr4xnSDxMaL) or models.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_STT_MODEL=scribe_v2
